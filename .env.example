# 复制为 .env 后按需覆盖；docker compose 会自动读取同目录下的 .env。
# 未设置的变量将回退到 docker-compose.yml 中的默认值（本地开发可直接用默认值）。

# MySQL root 密码（默认 123456，仅限本地开发）
MYSQL_ROOT_PASSWORD=123456

# MinIO 对象存储凭据（Milvus 会共用同一组凭据，见 docker-compose.yml）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── 应用进程（app / server 模块）────────────────────────────────────────────
# 注意：这些变量不会由 docker compose 注入到宿主机上的 Spring Boot 进程；
# 本地运行时请通过 shell 环境变量或 IDE Run Configuration 设置。
DEEPSEEK_API_KEY=
EMBEDDING_KEY=

# MCP Email Server
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465

# 主库连接（生产必须显式设置）
# DB_URL=jdbc:mysql://localhost:3306/superassistant
# DB_USERNAME=root
# DB_PASSWORD=123456

# 可选部署鉴权：设置后后端 /api/** 需要 Bearer Token；
# 前端构建/启动时用相同的 VITE_API_TOKEN。
APP_API_TOKEN=
# VITE_API_TOKEN=

# Milvus 连接（默认 localhost:9090）
# MILVUS_HOST=localhost
# MILVUS_PORT=9090
